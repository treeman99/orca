{
  // Orca 머신 전역 정책 — %ProgramData%\Orca\enterprise-policy.json
  //
  // 이 파일은 Orca 설치 프로그램이 **이 경로에 파일이 없을 때만** 만든 것입니다.
  // 설치·업데이트는 이미 있는 이 파일을 절대 덮어쓰지 않고, 제거해도 지우지 않습니다.
  // (지우면 다음 설치·업데이트 때 이 내용으로 다시 만들어집니다.)
  //
  // ⚠️ 이 파일은 설치 폴더에 내장된 정책(<설치폴더>\resources\enterprise-policy.json)보다 **우선합니다.**
  //    여기에 적지 않은 키는 lockdown 을 상속하고, 내장 정책은 그 빈칸을 **조이는 방향(true)으로만** 채웁니다.
  //    그래서 내장 정책에서 false 로 켜 두는 기능은 여기에도 false 로 적어야 켜집니다 — 아래 세 줄이 그것입니다.
  //    이후 판에서 그런 기능이 새로 생기면 이 파일에 직접 추가해야 합니다(README §5.2).
  //
  // 형식은 JSONC — // 주석과 후행 쉼표를 허용합니다. 바꾼 뒤에는 Orca 를 다시 시작하세요.
  // 전체 키 목록: docs/reference/enterprise-policy.md §3

  "lockdown": true,
  "githubEnterpriseHost": "github.samsungds.net",
  "disableAutoUpdate": false, // 사내 GHES 릴리스 태그 → 새 버전 알림
  "disableSkillBundleUpdate": false, // 사내 GHES daegun-kim/ORCA_skill main → 스킬 번들 갱신
  "disableUnattendedAgentRuns": false // 예약된 자동화가 사람 없이 에이전트를 띄우는 레인
}
